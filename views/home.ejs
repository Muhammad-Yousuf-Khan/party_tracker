<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Party Attendance</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #6a11cb;
            --secondary-color: #2575fc;
            --accent-color: #ff6b6b;
            --light-color: #f8f9fa;
            --dark-color: #212529;
        }
        
        body {
            background: linear-gradient(135deg, var(--light-color), white);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }
        
        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            overflow: hidden;
        }
        
        .card-header {
            background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
            color: white;
            font-weight: 600;
            text-align: center;
            padding: 1.5rem;
        }
        
        .btn-primary {
            background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
            border: none;
            padding: 10px 25px;
        }
        
        .btn-danger {
            background: var(--accent-color);
            border: none;
            padding: 10px 25px;
        }
        
        .stats-card {
            background: white;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 20px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }
        
        .student-list {
            max-height: 300px;
            overflow-y: auto;
        }
        
        .student-item {
            border-left: 4px solid var(--secondary-color);
            margin-bottom: 10px;
            padding: 10px 15px;
            background: white;
            border-radius: 5px;
            transition: all 0.3s ease;
        }
        
        .student-item:hover {
            transform: translateX(5px);
            box-shadow: 0 5px 10px rgba(0,0,0,0.1);
        }
        
        .entry-badge {
            background-color: #28a745;
        }
        
        .exit-badge {
            background-color: #dc3545;
        }
        
        @media (max-width: 768px) {
            .card-header {
                padding: 1rem;
            }
            
            .btn {
                width: 100%;
                margin-bottom: 10px;
            }
        }
    </style>
</head>
<body>

    <% if(locals.message){ %>
        <script>
            alert(' <%= message %> ')
        </script>
    <% } %>
    
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h2><i class="fas fa-party-horn me-2"></i> Party Attendance Tracker</h2>
                    </div>
                    <br>
                    <div class="card-body p-4">
                        
                        
                        <!-- Entry/Exit Forms -->
                        <div class="row g-3">
                            <div class="col-md-6">
                                <form action="/entry" method="POST">
                                    <h4 class="mb-3"><i class="fas fa-sign-in-alt me-2"></i>Student Entry</h4>
                                    <div class="mb-3">
                                        <label for="studentId" class="form-label">Student ID</label>
                                        <input type="number" class="form-control" id="studentId" name="studentId" placeholder="Enter student ID" required >
                                    </div>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-user-plus me-2"></i>Record Entry
                                    </button>
                                </form>
                            </div>
                            
                            <div class="col-md-6">
                                <form action="/exit" method="POST">
                                    <h4 class="mb-3"><i class="fas fa-sign-out-alt me-2"></i>Student Exit</h4>
                                    <div class="mb-3">
                                        <label for="exitStudentId" class="form-label">Student ID</label>
                                        <input type="number" class="form-control" id="exitStudentId" name="StudentId" placeholder="Enter student ID" required>
                                    </div>
                                    <button type="submit" class="btn btn-danger">
                                        <i class="fas fa-user-minus me-2"></i>Record Exit
                                    </button>
                                </form>
                            </div>
                        </div>
                        <br>
                        <!-- Stats Overview -->
                        <div class="row mb-4">
                            <div class="col-md-4">
                                <div class="stats-card text-center">
                                    <h5 class="text-muted">Total Students</h5>
                                    <% if(locals.t_stds){ %>
                                        <h3 class="fw-bold"> <%= t_stds %> </h3>
                                    <% } %>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="stats-card text-center">
                                    <h5 class="text-muted">Currently Inside</h5>
                                    <h3 class="fw-bold"> 
                                        <% if( locals.e_stds ){ %> 
                                            <%= e_stds %>
                                        <% }else{ %>
                                            0
                                        <% } %>
                                    </h3>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="stats-card text-center">
                                    <h5 class="text-muted">Currently Outside</h5>
                                    <h3 class="fw-bold">
                                        <% if( locals.o_stds ){ %> 
                                            <%= o_stds %>
                                        <% }else{ %>
                                            0
                                        <% } %>
                                    </h3>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>